# Server
MCP_SERVER_NAME=mcp-postgre-server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080
MCP_MOUNT_PATH=/mcp
MCP_AUTH_TOKEN=change-me
MCP_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DSN=postgresql://gitpilot:gitpilot@postgres:5432/gitpilot_dev
POSTGRES_ALLOWED_SCHEMAS=public
POSTGRES_READ_ONLY=true
POSTGRES_BLOCK_DDL=true
POSTGRES_BLOCK_DML=true
POSTGRES_MAX_ROWS=100
POSTGRES_QUERY_TIMEOUT_SECONDS=5
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_EXPLAIN_ANALYZE_ALLOWED=false
